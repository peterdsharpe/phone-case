__pycache__/
*.pyc
.scratch/
.ruff_cache/
build/
# regenerable with `python -m case.build` (large)
out/cad/
out/gcode/

# Full flow caches (all 16 snapshots, ~20 MB each); the snapshot the build uses is committed as data/snap_*.npz
